# Base URL da API FastAPI (backend PWIMDDIOT)
API_BASE_URL=http://localhost:8000

# Chave usada para assinar o cookie de sessao do Flask (onde o token JWT fica guardado).
# Gere uma forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-isto-por-uma-chave-aleatoria-forte

# Porta em que o front sobe
PORT=5000
